{
  "name": "download-manager",
  "productName": "Download Manager",
  "version": "1.0.0",
  "description": "Multi-connection desktop download manager (Electron + React) with an MCP server for AI assistants.",
  "author": "Dr Aran Castro <arancastro17@gmail.com>",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build": "npm run build:renderer && npm run build:mcp",
    "start": "npm run build && electron .",
    "test": "node --test \"test/*.test.*\"",
    "mcp": "node mcp/server.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist": "npm run build && electron-builder --publish never"
  },
  "build": {
    "appId": "online.draran.downloadmanager",
    "productName": "Download Manager",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-mcp",
        "to": "mcp"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5",
    "zod": "4.6.7"
  }
}
